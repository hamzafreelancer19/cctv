# Django
SECRET_KEY=dev-insecure-change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend
DATABASE_URL=postgres://sentinel:sentinel@db:5432/sentinelvision
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
EDGE_API_KEY=edge-dev-api-key-change-in-production

# Celery / Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=True

# Evidence (local | minio | s3)
EVIDENCE_STORAGE_BACKEND=local
AWS_S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_STORAGE_BUCKET_NAME=sentinelvision-evidence
EVIDENCE_SIGNED_URL_TTL_SECONDS=3600

# Notification providers (empty = stub success in workers)
SMS_PROVIDER_URL=
WHATSAPP_PROVIDER_URL=
PUSH_PROVIDER_URL=
NOTIFICATION_RATE_LIMIT_PER_MINUTE=60
DEFAULT_FROM_EMAIL=alerts@sentinelvision.local

# Observability
PROMETHEUS_ENABLED=True

# Vision AI — FREE local by default (no API key)
# Uses on-device YOLOv4-tiny COCO-80 to describe people/animals/objects.
VISION_LLM_PROVIDER=free
VISION_LLM_MODEL=llava
VISION_LLM_BASE_URL=http://127.0.0.1:11434/v1
VISION_LLM_API_KEY=
VISION_LLM_TIMEOUT_SEC=90
# Optional richer local LLM (still free, still no key) if Ollama is installed:
# VISION_LLM_PROVIDER=ollama
# VISION_LLM_MODEL=llava
