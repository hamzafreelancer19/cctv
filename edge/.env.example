API_BASE_URL=http://localhost:8000/api/v1
EDGE_API_KEY=edge-dev-api-key-change-in-production
CAMERA_ID=
HEARTBEAT_INTERVAL=30
SIMULATION_INTERVAL=10
EDGE_VERSION=0.5.0-m5

# M2 modes: auto | rtsp | simulation
EDGE_MODE=auto
# Detection: auto | yolo | simulated
DETECTION_BACKEND=simulated
YOLO_MODEL=yolov8n.pt
CONFIDENCE_THRESHOLD=0.5
TARGET_INFER_FPS=5
FRAME_QUEUE_SIZE=8
RECONNECT_DELAY_SEC=3
RECONNECT_MAX_DELAY_SEC=60
INFER_DEVICE=auto
LOITERING_SECONDS=120
OBJECT_LEFT_SECONDS=20
EVENT_COOLDOWN_SEC=15
ENABLE_SNAPSHOTS=false
SNAPSHOT_DIR=snapshots

# M3 face intelligence
ENABLE_FACE=true
FACE_BACKEND=auto
FACE_MATCH_THRESHOLD=0.45
FACE_MIN_QUALITY=0.35
FACE_MIN_BLUR=20

# M5 safety AI. Use custom safety weights/classes for production inference.
ENABLE_SAFETY=true
ENABLE_SAFETY_EVIDENCE=false
SAFETY_EVIDENCE_SECONDS=5

# Optional live source (takes priority in auto/rtsp mode):
# RTSP_URL=rtsp://user:pass@192.168.1.50:554/stream1
# Or local file / webcam index:
# VIDEO_SOURCE=sample.mp4
# VIDEO_SOURCE=0
